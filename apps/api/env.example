# PayPal API Credentials (Sandbox for testing)
PAYPAL_CLIENT_ID=your_sandbox_paypal_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_paypal_client_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Database
MONGO_URI=your_mongodb_connection_string

# Puppeteer Configuration (for PDF generation)
# Set this to the path of Chrome/Chromium executable in production
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Other
NODE_ENV=development
